{
  "name": "Spring Boot / Java Microservice Log",
  "type": "regex",
  "pattern": "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)\\s+(?P<level>[A-Z]+)\\s+(?P<pid>\\d+)?\\s*---\\s*\\[(?P<thread>[^\\]]+)\\]\\s+(?P<component>[\\w.]+)\\s*:\\s*(?P<message>.*)$",
  "timestamp_field": "timestamp",
  "timestamp_format": null,
  "level_field": "level",
  "component_field": "component",
  "message_field": "message",
  "default_source_system": "springboot_app",
  "timezone": "UTC",
  "min_match_ratio": 0.85
}